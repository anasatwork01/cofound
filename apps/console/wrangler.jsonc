{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "halyard-console",
  "main": ".open-next/worker.js",

  // workerd's latest published build sets the ceiling on how new this can be.
  // The adapter warns at build time once this is roughly six months old, so it
  // needs a refresh around March 2027.
  "compatibility_date": "2026-09-10",

  // `nodejs_compat` is implied by a compatibility_date >= 2026-08-04, but is
  // stated anyway: the table of which node: modules are real, stubbed or
  // polyfilled is documented against the flag being enabled.
  //
  // `global_fetch_strictly_public` is a SECURITY flag, not a functional one.
  // Without it, a server-side fetch from this Worker to one of Halyard's own
  // zones is routed straight to the origin, ignoring any Worker mapped to that
  // URL and bypassing Cloudflare security settings — so it would skip the WAF
  // and any Access policy in front of the API. See SPEC §17 and
  // docs/verified.md, SPEC §22 item 1. Do not remove it as "unnecessary".
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },

  "observability": {
    "enabled": true,
  },

  // --- environments -------------------------------------------------------
  //
  // Named environments, because task 0.12 needs staging and production to be
  // separately deployable. Two things about wrangler environments are easy to
  // get wrong and both are load-bearing here:
  //
  //   1. The top-level config above is the DEFAULT environment, so deploying
  //      without `--env` publishes to a worker named `halyard-console` that is
  //      neither staging nor production. Every deploy in
  //      .github/workflows/deploy-console.yml passes `--env` explicitly.
  //   2. Bindings are NOT inherited by named environments. `vars`, secrets, KV,
  //      R2 and Hyperdrive bindings must be repeated per environment, and the
  //      failure mode of forgetting is staging writing to production.
  //      `compatibility_date`, `compatibility_flags`, `main` and `assets` ARE
  //      inherited, which is why they are not repeated below.
  //
  // No Hyperdrive binding, deliberately. The console never touches Postgres --
  // SPEC 7.1 puts every read and write behind the Go `api` service, and a
  // Worker holding the control-plane database credential would invert 17.
  // Hyperdrive belongs to the generated user apps (tasks 3.9/3.12). See
  // docs/verified.md 22 item 4.
  "env": {
    "staging": {
      "name": "halyard-console-staging",
      "vars": {
        "HALYARD_ENV": "staging",
      },
    },
    "production": {
      "name": "halyard-console-production",
      "vars": {
        "HALYARD_ENV": "production",
      },
    },
  },
}
