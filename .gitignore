# --- dependencies ---
node_modules/
.pnpm-store/
.venv/
__pycache__/
*.py[cod]
.uv-cache/

# --- build output ---
dist/
build/
.next/
out/
.open-next/
.turbo/
bin/
*.test
coverage/
.coverage
htmlcov/
*.tsbuildinfo

# --- go workspace ---
# Created once modules depend on each other across the workspace. Each module's
# own go.sum carries the hashes, so nothing is lost by ignoring it.
go.work.sum

# --- local environment ---
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/**/*.pem

# --- tool caches ---
.mypy_cache/
.ruff_cache/
.pytest_cache/
.wrangler/
.dev.vars

# --- editors / os ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# --- local infra state ---
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
tmp/

# Next generates this and rewrites it on every `next typegen`.
# Next's own docs say it must not be committed or edited.
next-env.d.ts

# Next 16 writes these on `next dev`, and neither is ours. The CLAUDE.md is a
# one-line pointer at the AGENTS.md, so leaving it untracked keeps a generated
# file from being read as project instructions by an agent working in
# apps/console — this repo's real instructions are the CLAUDE.md at the root.
# Disable generation entirely with `agentRules: false` in next.config if the
# churn ever matters more than the Next 16 guidance they carry.
apps/console/AGENTS.md
apps/console/CLAUDE.md
